# ==============================================================================
# SEETHAPAATI MONOREPO — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file lists every environment variable required to take Seethapaati live.
#
# FOR BACKEND DEPLOYMENTS (Render, Railway, AWS, DigitalOcean):
# Configure these variables in your backend service environment settings (or apps/api/.env)
#
# FOR FRONTEND DEPLOYMENTS (Vercel, Cloudflare Pages, Netlify):
# Configure these variables in your frontend project settings (or apps/web/.env.production)
# ==============================================================================

# ==============================================================================
# BACKEND API (apps/api/.env)
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000

# PostgreSQL Connection (e.g. Neon, Supabase, AWS RDS, Render Postgres)
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/seethapaati?schema=public"

# Redis Cache & Queues (e.g. Upstash, Redis Cloud, Render Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Security (Generate a 32+ character key: openssl rand -base64 32)
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin (Set to your live frontend URL; comma-separated for multiple)
CORS_ORIGIN="https://seethapaati.com,https://www.seethapaati.com"

# Razorpay Payment Gateway (Live credentials from dashboard.razorpay.com)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Email Delivery (Resend API Key from https://resend.com)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="orders@seethapaati.com"

# Shiprocket Courier Integration (Optional: for automated courier dispatch)
# If omitted, manual admin tracking via /admin/orders remains fully functional.
SHIPROCKET_EMAIL="logistics@seethapaati.com"
SHIPROCKET_PASSWORD="YourShiprocketPassword"
SHIPROCKET_CHANNEL_ID=""
SHIPROCKET_WEBHOOK_TOKEN="your_custom_webhook_secret_token"

# Statutory Seller Configuration for Invoicing & GST Compliance
SELLER_LEGAL_NAME="Seethapaati Foods Private Limited"
SELLER_TRADE_NAME="Seethapaati"
SELLER_GSTIN="33ABCDE1234F1Z5"
SELLER_ADDRESS_LINE1="42, Heritage Kitchen Road, Mylapore"
SELLER_ADDRESS_LINE2=""
SELLER_CITY="Chennai"
SELLER_STATE="Tamil Nadu"
SELLER_STATE_CODE="33"
SELLER_PINCODE="600004"

# Inventory Reservation TTL & Auth Rate Limiting
RESERVATION_TTL_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# Initial Admin Password (Used during initial seed: npm run db:seed)
ADMIN_INITIAL_PASSWORD="YourStrongAdminPassword2026!"


# ==============================================================================
# FRONTEND WEB (apps/web/.env.production)
# ==============================================================================

# Live API Gateway Endpoint (Must end in /api/v1)
NEXT_PUBLIC_API_URL="https://api.seethapaati.com/api/v1"

# Storefront Brand Identity
NEXT_PUBLIC_STORE_NAME="SEETHAPAATI"
NEXT_PUBLIC_SITE_URL="https://seethapaati.com"

# Public Razorpay Key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"

# Google Search Console Verification (Optional: paste verification code here)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Analytics Toggle
NEXT_PUBLIC_ENABLE_ANALYTICS=false
