# Environment mode
NODE_ENV=development
PORT=4000

# PostgreSQL Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seethapaati_dev?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=development_jwt_secret_must_be_changed_in_prod_at_least_32_chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Payment Gateway (Razorpay Phase 1)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder
