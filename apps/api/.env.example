# ==============================================================================
# SEETHAPAATI BACKEND API (.env)
# ==============================================================================
# Copy this file to apps/api/.env and replace placeholders with your live values.

# ------------------------------------------------------------------------------
# SERVER & ENVIRONMENT
# ------------------------------------------------------------------------------
# Set to 'production' for live deployments. 'development' enables local fallback defaults.
NODE_ENV=production
PORT=4000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string to your production PostgreSQL database (e.g. Supabase, Neon, AWS RDS, Render Postgres).
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/seethapaati?schema=public"

# ------------------------------------------------------------------------------
# REDIS (Caching, BullMQ Queue & Session Locks)
# ------------------------------------------------------------------------------
# Connection details to your Redis instance (e.g. Upstash, Redis Cloud, Render Redis).
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key used for signing JWTs. In production, this MUST be at least 32 characters.
# Generate via: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins for the API. Must match your live web storefront domain.
# For multiple domains (e.g. custom domain + preview domain), separate with commas.
CORS_ORIGIN="https://seethapaati.com,https://www.seethapaati.com"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay Live Credentials)
# ------------------------------------------------------------------------------
# Retrieve these from your Razorpay Dashboard -> Settings -> API Keys & Webhooks.
# The Webhook Secret must match the secret you enter when registering your webhook endpoint.
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# EMAIL & NOTIFICATIONS (Resend)
# ------------------------------------------------------------------------------
# Required in production for order confirmation emails and status notifications.
# Get your API key from https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="orders@seethapaati.com"

# ------------------------------------------------------------------------------
# STATUTORY SELLER GST CONFIGURATION (Required for Tax Invoicing)
# ------------------------------------------------------------------------------
# Used for generating GST-compliant tax invoices.
# In production, SELLER_GSTIN must be your registered 15-character statutory GSTIN,
# and SELLER_STATE_CODE must match the first 2 digits of SELLER_GSTIN.
SELLER_LEGAL_NAME="Seethapaati Foods Private Limited"
SELLER_TRADE_NAME="Seethapaati"
SELLER_GSTIN="33ABCDE1234F1Z5"
SELLER_ADDRESS_LINE1="42, Heritage Kitchen Road, Mylapore"
SELLER_ADDRESS_LINE2=""
SELLER_CITY="Chennai"
SELLER_STATE="Tamil Nadu"
SELLER_STATE_CODE="33"
SELLER_PINCODE="600004"

# ------------------------------------------------------------------------------
# INVENTORY RESERVATION & RATE LIMITING
# ------------------------------------------------------------------------------
# Minutes before an uncompleted checkout reservation expires and returns stock to available pool.
RESERVATION_TTL_MINUTES=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10

# ------------------------------------------------------------------------------
# SHIPROCKET LOGISTICS & COURIER TRACKING (Optional)
# ------------------------------------------------------------------------------
# Required only if automating shipment creation with Shiprocket.
# If left blank, manual tracking input via /admin/orders remains fully active.
SHIPROCKET_EMAIL="logistics@seethapaati.com"
SHIPROCKET_PASSWORD="YourShiprocketPassword"
SHIPROCKET_CHANNEL_ID=""
SHIPROCKET_WEBHOOK_TOKEN="your_custom_webhook_secret_token"
