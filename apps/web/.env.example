# ==============================================================================
# SEETHAPAATI WEB STOREFRONT (.env.production / .env.local)
# ==============================================================================
# Copy this file to apps/web/.env.local (development) or configure in your hosting platform (Vercel/Render).

# ------------------------------------------------------------------------------
# BACKEND API GATEWAY
# ------------------------------------------------------------------------------
# URL to your deployed NestJS API (must include the /api/v1 prefix)
# Production: e.g. https://api.seethapaati.com/api/v1
# Development: http://localhost:4000/api/v1
NEXT_PUBLIC_API_URL=https://api.seethapaati.com/api/v1

# ------------------------------------------------------------------------------
# STOREFRONT BRANDING & SEO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STORE_NAME="SEETHAPAATI"
NEXT_PUBLIC_SITE_URL="https://seethapaati.com"

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay Client Key)
# ------------------------------------------------------------------------------
# Your public Razorpay Key ID (safe to expose in frontend client code)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------------------
# ANALYTICS & OBSERVABILITY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
